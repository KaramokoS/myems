# ==============================================================================
# MyEMS Portainer Stack Environment Variables
# Copy to .env or paste into Portainer "Environment variables" section
# ==============================================================================

# Database Password (used by MariaDB and all backend services)
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Image repository prefix and tag
IMAGE_PREFIX=myems
IMAGE_TAG=v6.9.0

# Timezone & Regional Settings
# TZ is the container OS timezone, UTC_OFFSET is MyEMS's offset from UTC.
# Keep them consistent: for Africa/Abidjan (GMT) use TZ=UTC and UTC_OFFSET=+00:00.
TZ=UTC
UTC_OFFSET=+00:00
CURRENCY_UNIT=CNY

# Aggregation / normalization scheduling
# MINUTES_TO_COUNT=60 means hourly energy consumption buckets
MINUTES_TO_COUNT=60
MINUTES_TO_CLEAN=30
POOL_SIZE=5

# Cleaning service retention
LIVE_IN_DAYS=365
