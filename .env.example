# ==============================================================================
# MyEMS Portainer Stack Environment Variables
# Copy to .env or paste into Portainer "Environment variables" section
# ==============================================================================

# Database Password (used by MariaDB and all backend services)
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Image repository prefix and tag
IMAGE_PREFIX=myems
IMAGE_TAG=v6.9.0

# Timezone & Regional Settings
TZ=UTC
UTC_OFFSET=+00:00
CURRENCY_UNIT=CNY
